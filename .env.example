# ---------------------------------------------------------------------------
# Toran example environment
#
# For development, `npm run dev:setup` creates `.env` from this file when it is
# missing. You do not need to copy anything by hand.
#
# For production, create `.env` from this template and replace every
# development credential and placeholder before starting Toran. NEVER commit a
# real `.env`.
#
# Every variable below is parsed and validated at startup by @toran/config.
# Toran refuses to boot in production when a required secret is missing or
# still set to one of the well-known development placeholder values. There is
# no flag that downgrades those checks to warnings.
#
# Each variable is marked:
#   [dev default]  fine as-is for local development
#   [production]   MUST be replaced before a production deployment
#   [managed]      `npm run dev` rewrites this for you while it runs
#   [compose]      read only by docker-compose.yml / docker-compose.dev.yml
#   [optional]     may be left unset
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production
# [dev default] [production: set to `production`]
NODE_ENV=development

# Public origin of the Toran web application (no trailing slash).
# [dev default] [managed] [production: must be https://]
TORAN_APP_URL=http://localhost:3000

# Public origin browsers are redirected to for object-storage traffic.
# In production this SHOULD be a hostname distinct from TORAN_APP_URL so that
# downloaded content can never execute against the application origin.
# [dev default] [managed] [production: must be https://]
TORAN_DOWNLOAD_URL=http://localhost:9000

# Port the web app listens on. [dev default]
PORT=3000

# trace | debug | info | warn | error | fatal. [dev default]
TORAN_LOG_LEVEL=debug

# Comma-separated CIDRs / IPs allowed to set X-Forwarded-For. Empty = trust none.
# Example for a single reverse proxy on the docker network: 172.16.0.0/12
# [optional] [production: set to your proxy, and nothing else]
TORAN_TRUSTED_PROXIES=

# Per-deployment secret used to key HMACs (anonymous identifiers, download
# authorization cookies). MUST be >= 32 characters in production.
#
# Generate one by running this in a terminal:
#
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Then paste the printed value here:
#
#   TORAN_SECRET_KEY=paste-the-generated-value-here
#
# Do not write a shell command as the value: an .env file is parsed, not
# executed, so `$(node ...)` would be stored literally.
# [dev default] [production: replace]
TORAN_SECRET_KEY=dev-insecure-secret-change-me-0000000000

# Send Secure cookies. [dev default] [production: must be true]
TORAN_SECURE_COOKIES=false

# --- PostgreSQL ------------------------------------------------------------
# [dev default] [production: replace, with a strong unique password]
DATABASE_URL=postgres://toran:toran@localhost:5432/toran
# Max pooled connections per process. [dev default]
DATABASE_POOL_MAX=10

# --- Object storage (S3-compatible) ----------------------------------------
# MinIO default for local development. For AWS S3 leave S3_ENDPOINT empty and
# set S3_FORCE_PATH_STYLE=false.
# [dev default] [managed]
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=toran
# [dev default] [production: replace with real storage credentials]
S3_ACCESS_KEY_ID=toranminio
S3_SECRET_ACCESS_KEY=toranminio-dev-secret
# MinIO requires path-style addressing; AWS S3 does not. [dev default]
S3_FORCE_PATH_STYLE=true
# Optional: endpoint the *browser* should talk to, when it differs from the
# in-cluster endpoint used for signing (e.g. `minio:9000` internally vs
# `http://localhost:9000` from the host). Signature stays valid because only
# the host is rewritten.
# [optional] [managed]
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Presigned URL lifetimes, in seconds. [dev default]
TORAN_UPLOAD_URL_TTL_SECONDS=900
TORAN_DOWNLOAD_URL_TTL_SECONDS=120

# --- Limits ----------------------------------------------------------------
# All [dev default]; tune deliberately for production.
# Largest single upload, in bytes. Default 100 MiB.
TORAN_MAX_FILE_SIZE_BYTES=104857600
# Default link lifetime when the user does not choose one, in seconds (24h).
TORAN_DEFAULT_EXPIRY_SECONDS=86400
# Longest lifetime a user may request, in seconds (7d).
TORAN_MAX_EXPIRY_SECONDS=604800
# Largest max-download value a user may request. Applied per file of a link.
TORAN_MAX_DOWNLOAD_LIMIT=1000
# Largest JSON request body accepted by the API, in bytes.
TORAN_MAX_REQUEST_BODY_BYTES=65536
# Per-request server timeout, in milliseconds.
TORAN_REQUEST_TIMEOUT_MS=15000

# Per-anonymous-identifier quotas. [dev default]
TORAN_ANON_MAX_ACTIVE_FILES=25
TORAN_ANON_MAX_STORAGE_BYTES=1073741824
TORAN_ANON_MAX_CONCURRENT_UPLOADS=3

# --- Rate limiting ---------------------------------------------------------
# memory | postgres
# `memory` is per-process and MUST NOT be used with more than one instance.
# [dev default] [production: must be `postgres`]
TORAN_RATE_LIMIT_BACKEND=memory
# "<max>/<windowSeconds>" [dev default]
TORAN_RATE_LIMIT_UPLOAD_CREATE=20/3600
TORAN_RATE_LIMIT_UPLOAD_COMPLETE=40/3600
TORAN_RATE_LIMIT_DOWNLOAD=120/3600
TORAN_RATE_LIMIT_PASSWORD=10/900
TORAN_RATE_LIMIT_REPORT=5/3600

# --- Malware scanning ------------------------------------------------------
# Disabling scanning is a DEVELOPMENT-ONLY escape hatch. Toran refuses to start
# in production with TORAN_SCANNING_ENABLED=false.
# [dev default] [production: must be true]
TORAN_SCANNING_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000
# Largest object Toran will stream to ClamAV. Larger objects fail closed and
# are marked `failed` rather than `ready`. Must be >= TORAN_MAX_FILE_SIZE_BYTES.
CLAMAV_MAX_SCAN_BYTES=104857600
# delete | quarantine
TORAN_BLOCKED_FILE_ACTION=quarantine

# --- Worker ----------------------------------------------------------------
# All [dev default].
TORAN_WORKER_CONCURRENCY=2
TORAN_WORKER_POLL_INTERVAL_MS=2000
TORAN_WORKER_JOB_LOCK_SECONDS=300
TORAN_WORKER_MAX_ATTEMPTS=5
TORAN_CLEANUP_INTERVAL_SECONDS=300
TORAN_CLEANUP_BATCH_SIZE=200
# How long a created-but-never-completed upload session may live, in seconds.
TORAN_UPLOAD_SESSION_TTL_SECONDS=3600
# How long download_events rows are retained, in days.
TORAN_DOWNLOAD_EVENT_RETENTION_DAYS=30

# --- Observability ---------------------------------------------------------
# [optional]
TORAN_OTEL_ENABLED=false
OTEL_SERVICE_NAME=toran
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Abuse contact (shown in the UI and docs) ------------------------------
# [optional] [production: set to an address you actually monitor]
TORAN_ABUSE_CONTACT_EMAIL=abuse@example.invalid

# --- Docker Compose only ---------------------------------------------------
# Used by docker-compose.yml to provision Postgres and MinIO, and to decide
# which interface each published port binds to. Toran itself never reads them.
#
# Generate strong values for the credentials below the same way as
# TORAN_SECRET_KEY, and keep them in step with DATABASE_URL, S3_ACCESS_KEY_ID
# and S3_SECRET_ACCESS_KEY above.
# [compose] [dev default] [production: replace all four credentials]
POSTGRES_USER=toran
POSTGRES_PASSWORD=toran
POSTGRES_DB=toran
MINIO_ROOT_USER=toranminio
MINIO_ROOT_PASSWORD=toranminio-dev-secret

# Interface and port the web app is published on by docker-compose.yml.
# Loopback is correct when a reverse proxy on the same host fronts Toran.
# [compose] [optional]
TORAN_BIND_ADDRESS=127.0.0.1
TORAN_PORT=3000

# Interface the MinIO port is published on. Loopback means only this machine
# can reach object storage, which is what you want unless you are sharing links
# on a local network. `npm run dev` manages this for you in development.
# [compose] [managed]
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_PORT=9000
