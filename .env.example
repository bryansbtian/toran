# Toran environment variables. `npm run dev:setup` creates .env from this file.
# Never commit your .env.

# Keys every HMAC. Must be 32+ chars in production.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TORAN_SECRET_KEY=dev-insecure-secret-change-me-0000000000

# Matches the Postgres in docker-compose.dev.yml.
DATABASE_URL=postgres://toran:toran@localhost:5432/toran

# Empty for AWS S3. This is the dev stack's MinIO.
S3_ENDPOINT=http://localhost:9000
# Keep the bucket private: Toran only hands out presigned URLs.
S3_BUCKET=toran
# Match the MinIO credentials in docker-compose.dev.yml.
S3_ACCESS_KEY_ID=toranminio
S3_SECRET_ACCESS_KEY=toranminio-dev-secret
